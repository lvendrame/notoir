+# Shared libraries do not require repeated archive scans. Preserve argument order
+# and framework pairs while removing repeated -l flags rejected by Darwin ld.
+unique_shared_libraries = $(if $(strip $(1)),$(firstword $(1)) $(call unique_shared_libraries,$(if $(filter -l%,$(firstword $(1))),$(filter-out $(firstword $(1)),$(wordlist 2,$(words $(1)),$(1))),$(wordlist 2,$(words $(1)),$(1)))))
+ifeq ($(CONFIG_SHARED),yes)
+FFEXTRALIBS := $(call unique_shared_libraries,$(FFEXTRALIBS))
+endif
